import "../fonts/Rajdhani-Medium.ttf";
import "../fonts/Rajdhani-SemiBold.ttf";
import "../fonts/Rajdhani-Bold.ttf";
import "../fonts/ShareTechMono-Regular.ttf";
import "../fonts/Orbitron-Bold.ttf";

export struct BookRow { id: string, name: string, chapters: int, current: bool, section: string }
export struct ChapterRow { num: int, current: bool }
export struct VerseRow { number: int, text: string, mark: string, has-note: bool, selected: bool, bookmarked: bool, lines: int, text2: string, lines2: int, side: bool }
export struct BookmarkRow { reference: string, snippet: string }
export struct WordChip { label: string, token: int }
export struct HitSeg { text: string, hl: bool }
export struct HitLine { segs: [HitSeg] }
export struct HitRow { reference: string, snippet: string, lines: [HitLine] }
export struct VersionRow { id: string, label: string, enabled: bool, active: bool, builtin: bool, compare: bool }
export struct LiveRow { id: string, label: string, active: bool }
export struct LinkChip { label: string, book-id: string, chapter: int, verse: int }

export global Theme {
    in-out property <bool> light: false;
    in-out property <string> palette: "default";
    out property <color> bg: palette == "sepia" ? #f1e6d0 : palette == "amber" ? #0c0905 : palette == "forest" ? #060d08 : palette == "contrast" ? #000000 : light ? #e7f3f6 : #05080e;
    out property <color> panel: palette == "sepia" ? #f8f0de : palette == "amber" ? #17110a : palette == "forest" ? #0b1a10 : palette == "contrast" ? #0a0a0a : light ? #f4fbfc : #07131d;
    out property <color> chrome: palette == "sepia" ? #eadcc0 : palette == "amber" ? #080603 : palette == "forest" ? #040a06 : palette == "contrast" ? #000000 : light ? #e8f6f8 : #040a10;
    out property <color> cyan: palette == "sepia" ? #7a4b12 : palette == "amber" ? #ffb02e : palette == "forest" ? #5dff9d : palette == "contrast" ? #ffee00 : light ? #087888 : #3df0ff;
    out property <color> text: palette == "sepia" ? #3b2a14 : palette == "amber" ? #fff0d6 : palette == "forest" ? #e6ffee : palette == "contrast" ? #ffffff : light ? #062028 : #e7fbff;
    out property <color> muted: palette == "sepia" ? #7a6548 : palette == "amber" ? #b59a73 : palette == "forest" ? #8fb89d : palette == "contrast" ? #d0d0d0 : light ? #3e6270 : #93b0c0;
    out property <color> line: palette == "sepia" ? #7a4b1252 : palette == "amber" ? #ffb02e48 : palette == "forest" ? #5dff9d48 : palette == "contrast" ? #ffee0090 : light ? #086e8052 : #3df0ff48;
    out property <color> line-soft: palette == "sepia" ? #7a4b122e : palette == "amber" ? #ffb02e2e : palette == "forest" ? #5dff9d2e : palette == "contrast" ? #ffee0060 : light ? #086e802e : #3df0ff2e;
    out property <color> input: palette == "sepia" ? #fffaf0 : palette == "amber" ? #080603 : palette == "forest" ? #040a06 : palette == "contrast" ? #000000 : light ? #ffffff : #040a10;
    out property <color> hover: palette == "sepia" ? #7a4b121a : palette == "amber" ? #ffb02e14 : palette == "forest" ? #5dff9d14 : palette == "contrast" ? #ffee0026 : light ? #0878881a : #3df0ff14;
    out property <color> magenta: light ? #c2186a : #ff3d9a;
    out property <color> amber: light ? #9a6408 : #ffc14a;
    out property <color> ok: light ? #0c7a58 : #7dffe0;
    out property <color> red: light ? #d0122a : #ff2a33;
}

export global Session {
    in-out property <string> view: "home";
    in-out property <string> theme-mode: "system";
    in-out property <string> place-title: "Genesis 1";
    in-out property <string> version-label: "KJV 1611";
    in-out property <string> status: "READY";
    in-out property <string> clock: "";
    in-out property <string> continue-ref: "Genesis 1";
    in-out property <string> continue-snippet: "";
    in-out property <int> note-count: 0;
    in-out property <int> mark-count: 0;
    in-out property <int> version-count: 1;
    in-out property <bool> verse-open: false;
    in-out property <string> verse-ref: "";
    in-out property <string> note-text: "";
    in-out property <string> link-text: "";
    in-out property <string> mark-color: "amber";
    in-out property <string> sense-word: "";
    in-out property <string> sense-text: "Select a word in the verse, or type one below.";
    in-out property <string> modern-text: "";
    in-out property <string> search-summary: "";
    in-out property <string> desktop-appearance: "Desktop is dark";
    in-out property <string> resolved-theme: "SYSTEM · DARK";
    in-out property <int> reading-size: 21;
    in-out property <int> verse-gap: 8;
    in-out property <bool> reading-mode: false;
    in-out property <int> focus-request: 0;
    in-out property <int> focus-verse: 0;
    in-out property <int> focus-token: 0;
    in-out property <int> chapter-token: 0;
    in-out property <length> scroll-y: 0px;
    in-out property <length> chapter-x: 0px;
    in-out property <int> active-token: -1;
    in-out property <bool> can-prev: false;
    in-out property <bool> can-next: true;
    in-out property <[BookRow]> books;
    in-out property <[ChapterRow]> chapters;
    in-out property <[VerseRow]> verses;
    in-out property <[WordChip]> words;
    in-out property <[HitRow]> hits;
    in-out property <[VersionRow]> versions;
    in-out property <[LiveRow]> live-versions;
    in-out property <[LinkChip]> links;
    in-out property <[HitRow]> word-hits;
    in-out property <[BookmarkRow]> bookmarks;
    in-out property <bool> export-popup: false;
    in-out property <string> export-from: "";
    in-out property <string> export-to: "";
    in-out property <bool> export-notes: false;
    in-out property <bool> import-popup: false;
    in-out property <string> import-text: "";
    in-out property <string> search-scope: "all";
    in-out property <string> search-book: "";
    in-out property <bool> compare-on: false;
    in-out property <string> compare-label: "";
    in-out property <bool> can-back: false;
    in-out property <bool> is-bookmarked: false;
    in-out property <int> bookmark-count: 0;
    in-out property <string> query-word: "";
    in-out property <bool> lookup-busy: false;
    // Where the word popup should sit: just under the line of text that was pressed.
    in-out property <bool> popup-anchored: false;
    in-out property <length> popup-x: 0px;
    in-out property <length> popup-bottom: 0px;
    in-out property <length> popup-line: 0px;
    in-out property <bool> popup-open: false;
    in-out property <bool> ref-popup: false;
    in-out property <bool> chapter-popup: false;
    in-out property <bool> intro-available: false;
    in-out property <bool> intro-on-start: false;

    callback commit-note();
    callback save-note();
    callback pick-verse(int);
    callback mark-verse(int);
    callback set-mark(string);
    callback clear-mark();
    callback copy-verse();
    callback lookup-token(int);
    callback lookup-typed(string);
    callback step(int);
    callback select-book(string);
    callback select-chapter(int);
    callback set-theme(string);
    callback bump-size(int);
    callback set-version(string);
    callback toggle-version(string);
    callback drop-version(string);
    callback import-bible();
    callback continue-reading();
    callback open-hit(int);
    callback open-link(string, int, int);
    callback search-words(string);
    callback search-passage(string);
    callback hit-width(float);
    callback bump-gap(int);
    callback export-passage(string);
    callback export-backup();
    callback import-backup();
    callback import-apply(bool);
    callback import-cancel();
    callback set-compare(bool);
    callback set-compare-version(string);
    callback go-back();
    callback toggle-bookmark();
    callback open-bookmark(int);
    callback delete-bookmark(int);
    callback word-popup(int);
    callback verse-word-click(int, float, float);
    callback verse-word-hold(int, float, float);
    callback text-width(float);
    callback search-this-word();
    callback play-intro();
    callback set-intro-on-start(bool);
}

component Kicker inherits Text {
    font-family: "Share Tech Mono";
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 1.6px;
    color: Theme.muted;
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    height: 32px;
    border-width: 1px;
    border-color: root.active ? Theme.cyan : Theme.line-soft;
    background: root.active ? Theme.hover : transparent;
    Text {
        text: root.label;
        color: root.active ? Theme.cyan : Theme.muted;
        font-family: "Rajdhani";
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback accepted(string);
    height: 36px;
    public function focus-input() { input.focus(); }
    background: Theme.input;
    border-width: 1px;
    border-color: Theme.line;
    Text {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        visible: input.text == "";
        text: root.placeholder;
        color: Theme.muted;
        font-family: "Rajdhani";
        font-weight: 600;
        font-size: 16px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: 100%;
        text <=> root.text;
        color: Theme.text;
        font-family: "Rajdhani";
        font-weight: 600;
        font-size: 16px;
        vertical-alignment: center;
        selection-background-color: Theme.light ? #08788833 : #3df0ff33;
        selection-foreground-color: Theme.text;
        accepted => { root.accepted(self.text); }
    }
}

component BookRowView inherits Rectangle {
    in property <string> id;
    in property <string> name;
    in property <int> chapters;
    in property <bool> current;
    in property <string> section;
    height: (root.section == "" ? 0px : 24px) + 32px;
    background: root.current || touch.has-hover ? Theme.hover : transparent;
    VerticalLayout {
        if root.section != "": Kicker {
            text: root.section;
            height: 24px;
            vertical-alignment: center;
            x: 12px;
        }
        Rectangle {
            height: 32px;
            Rectangle {
                width: 2px;
                height: 100%;
                background: root.current ? Theme.cyan : transparent;
            }
            Text {
                x: 12px;
                text: root.name;
                font-family: "Rajdhani";
                font-weight: root.current ? 700 : 600;
                font-size: 16px;
                color: root.current ? Theme.cyan : Theme.text;
                vertical-alignment: center;
                height: 100%;
            }
            Text {
                x: parent.width - 40px;
                width: 28px;
                text: "\{root.chapters}";
                font-family: "Share Tech Mono";
                font-size: 11px;
                color: Theme.muted;
                horizontal-alignment: right;
                vertical-alignment: center;
                height: 100%;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Session.select-book(root.id); }
    }
}

component ChapterChip inherits Rectangle {
    in property <int> num;
    in property <bool> current;
    private property <int> watch: Session.chapter-token;
    width: 34px;
    height: 28px;
    border-width: 1px;
    border-color: root.current ? Theme.cyan : Theme.line-soft;
    background: root.current ? Theme.hover : transparent;
    Text {
        text: "\{root.num}";
        color: root.current ? Theme.cyan : Theme.muted;
        font-family: "Share Tech Mono";
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { Session.select-chapter(root.num); }
    }
    changed watch => {
        if root.current { Session.chapter-x = self.x; }
    }
    changed x => {
        if root.current && Session.chapter-token > 0 { Session.chapter-x = self.x; }
    }
}

component VerseLine inherits Rectangle {
    in property <int> number;
    in property <string> body;
    in property <string> mark;
    in property <bool> has-note;
    in property <bool> selected;
    in property <bool> bookmarked: false;
    in property <string> body2;
    in property <int> lines2: 0;
    in property <bool> side: false;
    in property <int> lines: 1;
    private property <bool> fired: false;
    private property <int> token-watch: Session.focus-token;
    private property <color> ink: mark == "magenta" ? Theme.magenta
        : mark == "amber" ? Theme.amber
        : mark == "mint" ? Theme.ok
        : mark == "red" ? Theme.red
        : Theme.cyan;
    private property <length> h1: max(body.preferred-height, 22px);
    private property <length> h2: root.body2 == "" ? 0px : body2-text.preferred-height;
    private property <length> colw: (root.width - 84px - 24px) / 2;
    height: (root.body2 == "" ? root.h1 : (root.side ? max(root.h1, root.h2) : root.h1 + 6px + root.h2)) + Session.verse-gap * 2px;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.cyan;
    // x is required. A fixed width with no x is centered, which drew this bar through the words.
    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        visible: mark != "";
        background: root.ink;
    }
    Rectangle {
        x: 20px;
        y: 0px;
        width: 7px;
        height: 11px;
        visible: root.bookmarked;
        background: Theme.amber;
    }
    Rectangle {
        x: 12px;
        y: (parent.height - 14px) / 2;
        width: 12px;
        height: 14px;
        visible: root.has-note;
        border-width: 1px;
        border-color: Theme.cyan;
        Rectangle { x: 7px; y: 0; width: 5px; height: 5px; background: Theme.cyan; }
    }
    Text {
        x: 30px;
        width: 36px;
        height: 100%;
        text: "\{root.number}";
        font-family: "Share Tech Mono";
        font-size: 13px;
        color: Theme.cyan;
        vertical-alignment: center;
    }
    body := Text {
        x: 70px;
        y: Session.verse-gap * 1px;
        width: root.side && root.body2 != "" ? root.colw : parent.width - 84px;
        text: root.body;
        wrap: no-wrap;
        font-family: "Rajdhani";
        font-weight: 500;
        font-size: Session.reading-size * 1px;
        color: root.mark == "" ? Theme.text : root.ink;
    }
    body2-text := Text {
        visible: root.body2 != "";
        x: root.side ? 70px + root.colw + 24px : 70px;
        y: root.side ? Session.verse-gap * 1px : Session.verse-gap * 1px + root.h1 + 6px;
        width: root.side ? root.colw : parent.width - 84px;
        text: root.body2;
        wrap: no-wrap;
        font-family: "Rajdhani";
        font-weight: 500;
        font-size: Session.reading-size * 1px;
        color: Theme.muted;
    }
    // Remember where the press landed (window coordinates) so the word popup can open just
    // below that line of text instead of covering it.
    function anchor() {
        let lh = body.preferred-height / max(root.lines, 1);
        let row = floor((touch.pressed-y - Session.verse-gap * 1px) / lh);
        Session.popup-anchored = true;
        Session.popup-x = touch.absolute-position.x + touch.pressed-x;
        Session.popup-line = lh;
        Session.popup-bottom = touch.absolute-position.y + Session.verse-gap * 1px + (max(row, 0) + 1) * lh;
    }
    Timer {
        interval: 500ms;
        running: touch.pressed && !root.fired && touch.pressed-x >= 72px;
        triggered => {
            root.fired = true;
            root.anchor();
            Session.verse-word-hold(root.number, (touch.pressed-y - Session.verse-gap * 1px) / (body.preferred-height / max(root.lines, 1)), (touch.pressed-x - 70px) / 1px);
        }
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.fired = false; }
        }
        clicked => {
            if (root.fired) {
                // The press already opened the word popup.
            } else if (self.pressed-x < 72px) {
                Session.mark-verse(root.number);
            } else {
                Session.focus-request += 1;
                root.anchor();
                Session.verse-word-click(root.number, (self.pressed-y - Session.verse-gap * 1px) / (body.preferred-height / max(root.lines, 1)), (self.pressed-x - 70px) / 1px);
            }
        }
    }
    changed token-watch => {
        if root.number == Session.focus-verse && Session.focus-verse > 0 {
            Session.scroll-y = self.y;
        }
    }
    changed y => {
        if root.number == Session.focus-verse && Session.focus-verse > 0 {
            Session.scroll-y = self.y;
        }
    }
}

component WordButton inherits Rectangle {
    in property <string> label;
    in property <int> token;
    property <bool> on: Session.active-token == root.token;
    property <bool> fired: false;
    Timer {
        interval: 500ms;
        running: touch.pressed && !root.fired;
        triggered => {
            root.fired = true;
            Session.popup-anchored = false;
            Session.word-popup(root.token);
        }
    }
    width: label-text.preferred-width + 14px;
    height: 26px;
    border-width: 1px;
    border-color: root.on ? Theme.cyan : Theme.line-soft;
    background: root.on ? Theme.hover : transparent;
    label-text := Text {
        text: root.label;
        font-family: "Rajdhani";
        font-weight: 600;
        font-size: 14px;
        color: root.on ? Theme.cyan : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.fired = false; }
        }
        clicked => { if !root.fired { Session.lookup-token(root.token); } }
    }
}

component WordStrip inherits Rectangle {
    height: 44px;
    TouchArea {
        scroll-event(event) => {
            word-flick.content-x = min(0px, max(word-flick.width - word-flick.content-width,
                word-flick.content-x + event.delta-y + event.delta-x));
            accept
        }
        word-flick := Flickable {
            y: 0px;
            height: 32px;
            width: parent.width;
            content-width: word-row.preferred-width;
            word-row := HorizontalLayout {
                spacing: 4px;
                for word in Session.words: WordButton { label: word.label; token: word.token; }
            }
        }
        Rectangle {
            y: 36px;
            height: 6px;
            width: parent.width;
            background: Theme.line-soft;
            visible: word-flick.content-width > word-flick.width;
            Rectangle {
                height: 100%;
                width: max(16px, parent.width * word-flick.width / max(word-flick.content-width, 1px));
                x: (parent.width - self.width) * (-word-flick.content-x) / max(word-flick.content-width - word-flick.width, 1px);
                background: Theme.cyan;
            }
        }
    }
}

component HitView inherits Rectangle {
    in property <string> reference;
    in property <string> snippet;
    in property <[HitLine]> lines;
    in property <int> index;
    height: hit-col.preferred-height;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.cyan : Theme.line-soft;
    background: touch.has-hover ? Theme.hover : Theme.panel;
    hit-col := VerticalLayout {
        padding: 8px;
        spacing: 2px;
        Text {
            text: root.reference;
            font-family: "Rajdhani";
            font-weight: 700;
            font-size: 15px;
            color: Theme.cyan;
        }
        if root.lines.length == 0: Text {
            text: root.snippet;
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 500;
            font-size: 15px;
            color: Theme.text;
        }
        for line in root.lines: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for seg in line.segs: Text {
                text: seg.text;
                wrap: no-wrap;
                font-family: "Rajdhani";
                font-weight: seg.hl ? 700 : 500;
                font-size: 15px;
                color: seg.hl ? Theme.amber : Theme.text;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { Session.open-hit(root.index); }
    }
}

component VersionLine inherits Rectangle {
    in property <string> id;
    in property <string> label;
    in property <bool> enabled;
    in property <bool> active;
    in property <bool> builtin;
    in property <bool> compare;
    height: 42px;
    border-width: 1px;
    border-color: root.active ? Theme.cyan : Theme.line-soft;
    background: root.active ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        alignment: stretch;
        Text {
            text: root.label;
            font-family: "Rajdhani";
            font-weight: 700;
            font-size: 16px;
            color: root.active ? Theme.cyan : Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.active: Kicker { text: "ACTIVE"; vertical-alignment: center; color: Theme.cyan; }
        if !root.active && root.enabled: Rectangle {
            width: 64px;
            Btn { label: "USE"; clicked => { Session.set-version(root.id); } }
        }
        Rectangle {
            width: 64px;
            Btn { label: "2ND"; active: root.compare; clicked => { Session.set-compare-version(root.id); } }
        }
        if root.id != "kjv": Rectangle {
            width: 72px;
            Btn {
                label: root.enabled ? "ON" : "OFF";
                active: root.enabled;
                clicked => { Session.toggle-version(root.id); }
            }
        }
        if !root.builtin: Rectangle {
            width: 72px;
            Btn { label: "DROP"; clicked => { Session.drop-version(root.id); } }
        }
    }
}

component PopupFrame inherits Rectangle {
    in property <length> box-width: 460px;
    callback dismiss();
    z: 10;
    background: #00000088;
    TouchArea { clicked => { root.dismiss(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            reject
        }
        Rectangle {
            width: min(root.box-width, root.width - 40px);
            height: min(root.height - 40px, content.preferred-height + 32px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.cyan;
            TouchArea {}
            content := VerticalLayout {
                padding: 16px;
                spacing: 8px;
                @children
            }
        }
    }
}

// Pre-rendered loop of the Grok Bot model (assets/grokbot). Slint has no 3D, so the
// animation plays as a frame sequence, only while a definition lookup is in flight.
component GrokBotSprite inherits Rectangle {
    in property <bool> busy: false;
    private property <int> frame: 0;
    private property <[image]> frames: [
        @image-url("../assets/grokbot/grokbot_00.png"),
        @image-url("../assets/grokbot/grokbot_01.png"),
        @image-url("../assets/grokbot/grokbot_02.png"),
        @image-url("../assets/grokbot/grokbot_03.png"),
        @image-url("../assets/grokbot/grokbot_04.png"),
        @image-url("../assets/grokbot/grokbot_05.png"),
        @image-url("../assets/grokbot/grokbot_06.png"),
        @image-url("../assets/grokbot/grokbot_07.png"),
        @image-url("../assets/grokbot/grokbot_08.png"),
        @image-url("../assets/grokbot/grokbot_09.png"),
        @image-url("../assets/grokbot/grokbot_10.png"),
        @image-url("../assets/grokbot/grokbot_11.png"),
        @image-url("../assets/grokbot/grokbot_12.png"),
        @image-url("../assets/grokbot/grokbot_13.png"),
        @image-url("../assets/grokbot/grokbot_14.png"),
        @image-url("../assets/grokbot/grokbot_15.png"),
        @image-url("../assets/grokbot/grokbot_16.png"),
        @image-url("../assets/grokbot/grokbot_17.png"),
        @image-url("../assets/grokbot/grokbot_18.png"),
        @image-url("../assets/grokbot/grokbot_19.png"),
        @image-url("../assets/grokbot/grokbot_20.png"),
        @image-url("../assets/grokbot/grokbot_21.png"),
        @image-url("../assets/grokbot/grokbot_22.png"),
        @image-url("../assets/grokbot/grokbot_23.png"),
        @image-url("../assets/grokbot/grokbot_24.png"),
        @image-url("../assets/grokbot/grokbot_25.png"),
        @image-url("../assets/grokbot/grokbot_26.png"),
        @image-url("../assets/grokbot/grokbot_27.png"),
        @image-url("../assets/grokbot/grokbot_28.png"),
        @image-url("../assets/grokbot/grokbot_29.png")
    ];
    // The frames run right up to their top edge (cloud and halo), so the image sits 8px
    // below the top of this box. That keeps it clear of the popup border.
    width: 84px;
    height: 80px;
    Timer {
        interval: 110ms;
        running: root.busy;
        triggered => { root.frame = mod(root.frame + 1, 30); }
    }
    Image {
        x: 0px;
        y: 8px;
        width: 100%;
        height: parent.height - 8px;
        image-fit: contain;
        source: root.frames[root.frame];
    }
}

// ------------------------------------------------------------------ Outreach

export struct ContactRow { id: int, name: string, phone: string, email: string, prayer: string, initials: string, photo: image, has-photo: bool, has-email: bool, in-pool: bool, fulfilled: bool }
export struct CalCell { day: int, in-month: bool, today: bool, selected: bool, count: int, t1: string, t2: string }
export struct EvRow { id: int, title: string, when: string, details: string, repeat: string }

export global Outreach {
    // planner
    in-out property <string> tab: "contacts";
    in-out property <string> hint: "";
    in-out property <string> month-label: "";
    in-out property <string> selected-label: "";
    in-out property <int> contact-count: 0;
    in-out property <[ContactRow]> contacts;
    in-out property <[ContactRow]> pool-list;
    in-out property <[CalCell]> cells;
    in-out property <[EvRow]> day-events;
    in-out property <[EvRow]> upcoming;
    // home prayer card
    in-out property <bool> pr-has: false;
    in-out property <string> pr-name: "";
    in-out property <string> pr-request: "";
    in-out property <string> pr-initials: "";
    in-out property <image> pr-photo;
    in-out property <bool> pr-has-photo: false;
    in-out property <int> pr-pool-size: 0;
    // contact card popup
    in-out property <bool> card-open: false;
    in-out property <int> c-id: -1;
    in-out property <string> c-name: "";
    in-out property <string> c-phone: "";
    in-out property <string> c-email: "";
    in-out property <string> c-prayer: "";
    in-out property <bool> c-fulfilled: false;
    in-out property <bool> c-pool: false;
    in-out property <image> c-photo;
    in-out property <bool> c-has-photo: false;
    in-out property <string> c-initials: "?";
    in-out property <string> c-error: "";
    // event popup
    in-out property <bool> event-open: false;
    in-out property <int> e-id: -1;
    in-out property <string> e-title: "";
    in-out property <string> e-date: "";
    in-out property <string> e-time: "";
    in-out property <string> e-details: "";
    in-out property <string> e-repeat: "none";
    in-out property <[bool]> e-days: [false, false, false, false, false, false, false];
    in-out property <string> e-note: "";
    in-out property <string> e-error: "";
    // delete confirmation
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-text: "";

    callback open();
    callback prev-month();
    callback next-month();
    callback this-month();
    callback select-day(int);
    callback add-contact();
    callback edit-contact(int);
    callback pick-photo();
    callback clear-photo();
    callback save-contact();
    callback ask-delete-contact();
    callback copy-contact(int);
    callback email-contact(int);
    callback toggle-pool(int);
    callback add-event-for(int);
    callback add-event-day();
    callback edit-event(int);
    callback save-event();
    callback ask-delete-event();
    callback set-repeat(string);
    callback toggle-day(int);
    callback step-date(int);
    callback step-time(int);
    callback confirm-yes();
    callback close-popups();
}

component Icon inherits Rectangle {
    in property <string> kind;
    in property <color> ink: Theme.muted;
    in property <bool> filled: false;
    width: 22px;
    height: 22px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.kind == "copy" ? "M 9 9 H 20 V 21 H 9 Z M 5.5 15 H 4 V 3 H 15 V 5.5"
            : root.kind == "mail" ? "M 3 6 H 21 V 19 H 3 Z M 3.5 7 L 12 14 L 20.5 7"
            : root.kind == "cal" ? "M 3 5 H 21 V 21 H 3 Z M 3 10 H 21 M 8 2 V 7 M 16 2 V 7 M 12 12.5 V 18.5 M 9 15.5 H 15"
            : root.kind == "plus" ? "M 12 4 V 20 M 4 12 H 20"
            : "M 11.3 1.8 C 7.5 4.5 4.2 9 3.8 14.5 L 6.2 18.2 H 11.3 Z M 12.7 1.8 C 16.5 4.5 19.8 9 20.2 14.5 L 17.8 18.2 H 12.7 Z M 8 7.5 L 8.6 13.5 M 16 7.5 L 15.4 13.5 M 6.2 18.2 L 6.6 22.2 H 11.3 V 18.2 M 17.8 18.2 L 17.4 22.2 H 12.7 V 18.2";
        stroke: root.ink;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.filled ? root.ink.with-alpha(0.32) : transparent;
    }
}

component IconBtn inherits Rectangle {
    in property <string> kind;
    in property <string> tip;
    in property <bool> on: false;
    callback clicked();
    width: 30px;
    height: 30px;
    border-width: 1px;
    border-color: touch.has-hover || root.on ? Theme.cyan : Theme.line-soft;
    background: touch.has-hover ? Theme.hover : transparent;
    Icon {
        kind: root.kind;
        filled: root.on;
        ink: touch.has-hover || root.on ? Theme.cyan : Theme.muted;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => { Outreach.hint = self.has-hover ? root.tip : ""; }
    }
}

component DangerBtn inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 32px;
    border-width: 1px;
    border-color: Theme.red;
    background: dtouch.has-hover ? Theme.red.with-alpha(0.18) : transparent;
    Text {
        text: root.label;
        color: Theme.red;
        font-family: "Rajdhani";
        font-weight: 700;
        font-size: 13px;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    dtouch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Avatar inherits Rectangle {
    in property <image> photo;
    in property <bool> has-photo;
    in property <string> initials;
    in property <length> size: 40px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    clip: true;
    background: Theme.hover;
    border-width: 1px;
    border-color: Theme.line;
    if root.has-photo: Image {
        source: root.photo;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
    if !root.has-photo: Text {
        text: root.initials;
        color: Theme.cyan;
        font-family: "Rajdhani";
        font-weight: 700;
        font-size: root.size * 0.4;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 40px;
    border-width: 1px;
    border-color: root.active ? Theme.cyan : Theme.line-soft;
    background: root.active ? Theme.hover : ttouch.has-hover ? Theme.hover : transparent;
    Text {
        text: root.label;
        color: root.active ? Theme.cyan : Theme.muted;
        font-family: "Rajdhani";
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 1.2px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ttouch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component ContactItem inherits Rectangle {
    in property <ContactRow> c;
    height: 64px;
    background: row-touch.has-hover ? Theme.hover : transparent;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line-soft; }
    row-touch := TouchArea { mouse-cursor: pointer; clicked => { Outreach.edit-contact(root.c.id); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;
        Avatar { photo: root.c.photo; has-photo: root.c.has-photo; initials: root.c.initials; size: 44px; y: (parent.height - 44px) / 2; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 0px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.c.name;
                    color: Theme.text;
                    font-family: "Rajdhani";
                    font-weight: 700;
                    font-size: 17px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.c.fulfilled: Text {
                    text: "ANSWERED";
                    color: Theme.ok;
                    font-family: "Share Tech Mono";
                    font-size: 9px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.c.phone != "" ? root.c.phone : root.c.email;
                color: Theme.muted;
                font-family: "Rajdhani";
                font-weight: 600;
                font-size: 13px;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 4px;
            alignment: end;
            width: root.c.has-email ? 136px : 102px;
            IconBtn { y: (parent.height - 30px) / 2; kind: "cal"; tip: "ADD TO CALENDAR"; clicked => { Outreach.add-event-for(root.c.id); } }
            IconBtn { y: (parent.height - 30px) / 2; kind: "copy"; tip: "COPY CONTACT INFO"; clicked => { Outreach.copy-contact(root.c.id); } }
            if root.c.has-email: IconBtn { y: (parent.height - 30px) / 2; kind: "mail"; tip: "EMAIL " + root.c.email; clicked => { Outreach.email-contact(root.c.id); } }
            IconBtn {
                y: (parent.height - 30px) / 2;
                kind: "pray";
                on: root.c.in-pool && !root.c.fulfilled;
                tip: root.c.fulfilled ? "PRAYER ANSWERED · NOT IN ROTATION" : root.c.in-pool ? "IN DAILY PRAYER · CLICK TO REMOVE" : "ADD TO DAILY PRAYER";
                clicked => { Outreach.toggle-pool(root.c.id); }
            }
        }
    }
}

component EventItem inherits Rectangle {
    in property <EvRow> e;
    height: 40px;
    background: etouch.has-hover ? Theme.hover : transparent;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line-soft; }
    etouch := TouchArea { mouse-cursor: pointer; clicked => { Outreach.edit-event(root.e.id); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            text: root.e.when;
            color: Theme.cyan;
            font-family: "Share Tech Mono";
            font-size: 12px;
            vertical-alignment: center;
            width: 124px;
            overflow: elide;
        }
        Text {
            text: root.e.title;
            color: Theme.text;
            font-family: "Rajdhani";
            font-weight: 700;
            font-size: 16px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.e.repeat;
            color: Theme.muted;
            font-family: "Share Tech Mono";
            font-size: 10px;
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
            width: 96px;
        }
    }
}

component DayCell inherits Rectangle {
    in property <CalCell> cell;
    callback clicked();
    border-width: 1px;
    border-color: root.cell.selected ? Theme.cyan : Theme.line-soft;
    background: !root.cell.in-month ? transparent : dtouch.has-hover || root.cell.selected ? Theme.hover : Theme.panel;
    opacity: root.cell.in-month ? 1 : 0.35;
    if root.cell.day > 0: Rectangle {
        x: 4px;
        y: 4px;
        width: 24px;
        height: 20px;
        border-radius: 10px;
        background: root.cell.today ? Theme.cyan : transparent;
        Text {
            text: root.cell.day;
            color: root.cell.today ? Theme.bg : Theme.text;
            font-family: "Rajdhani";
            font-weight: 700;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.cell.count > 0: HorizontalLayout {
        x: parent.width - 36px;
        y: 10px;
        width: 32px;
        height: 8px;
        spacing: 3px;
        alignment: end;
        for i in min(root.cell.count, 3): Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.magenta; }
    }
    if root.cell.count > 0: VerticalLayout {
        x: 4px;
        y: 28px;
        width: parent.width - 8px;
        height: parent.height - 30px;
        spacing: 1px;
        alignment: start;
        Text { text: root.cell.t1; color: Theme.cyan; font-family: "Rajdhani"; font-weight: 600; font-size: 12px; overflow: elide; }
        Text { text: root.cell.t2; color: Theme.cyan; font-family: "Rajdhani"; font-weight: 600; font-size: 12px; overflow: elide; visible: root.cell.t2 != ""; }
        Text { text: root.cell.count > 2 ? "+" + (root.cell.count - 2) + " more" : ""; color: Theme.muted; font-family: "Share Tech Mono"; font-size: 9px; }
    }
    dtouch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component CalendarPane inherits Rectangle {
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            height: 32px;
            Rectangle { width: 40px; Btn { label: "◀"; clicked => { Outreach.prev-month(); } } }
            Text {
                text: Outreach.month-label;
                color: Theme.cyan;
                font-family: "Orbitron";
                font-weight: 700;
                font-size: 18px;
                letter-spacing: 2px;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle { width: 40px; Btn { label: "▶"; clicked => { Outreach.next-month(); } } }
            Rectangle { width: 80px; Btn { label: "TODAY"; active: true; clicked => { Outreach.this-month(); } } }
        }
        HorizontalLayout {
            height: 16px;
            for name in ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]: Text {
                text: name;
                horizontal-stretch: 1;
                horizontal-alignment: center;
                color: Theme.muted;
                font-family: "Share Tech Mono";
                font-size: 10px;
                letter-spacing: 1.2px;
            }
        }
        GridLayout {
            spacing: 2px;
            vertical-stretch: 1;
            for cell[i] in Outreach.cells: DayCell {
                row: floor(i / 7);
                col: mod(i, 7);
                cell: cell;
                clicked => { Outreach.select-day(i); }
            }
        }
        Rectangle {
            height: 148px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    Text {
                        text: Outreach.selected-label;
                        color: Theme.text;
                        font-family: "Rajdhani";
                        font-weight: 700;
                        font-size: 16px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Rectangle { width: 130px; Btn { label: "+ ADD EVENT"; active: true; clicked => { Outreach.add-event-day(); } } }
                }
                Flickable {
                    VerticalLayout {
                        width: parent.width;
                        if Outreach.day-events.length == 0: Text {
                            text: "Nothing planned this day.";
                            color: Theme.muted;
                            font-family: "Rajdhani";
                            font-weight: 600;
                            font-size: 14px;
                        }
                        for ev in Outreach.day-events: EventItem { e: ev; }
                    }
                }
            }
        }
    }
}

component ContactsPane inherits Rectangle {
    VerticalLayout {
        HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            height: 52px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Kicker { text: "CONTACTS"; }
                Text { text: Outreach.contact-count + (Outreach.contact-count == 1 ? " person" : " people"); color: Theme.text; font-family: "Rajdhani"; font-weight: 700; font-size: 15px; }
            }
            Rectangle { width: 96px; Btn { label: "+ ADD"; active: true; clicked => { Outreach.add-contact(); } } }
        }
        Rectangle { height: 1px; background: Theme.line-soft; }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width;
                if Outreach.contacts.length == 0: Text {
                    text: "No contacts yet. Press + ADD to make the first card.";
                    wrap: word-wrap;
                    color: Theme.muted;
                    font-family: "Rajdhani";
                    font-weight: 600;
                    font-size: 15px;
                }
                for c in Outreach.contacts: ContactItem { c: c; }
            }
        }
    }
}

component PrayerPane inherits Rectangle {
    VerticalLayout {
        HorizontalLayout {
            padding: 10px;
            height: 52px;
            VerticalLayout {
                alignment: center;
                Kicker { text: "DAILY PRAYER POOL"; }
                Text { text: Outreach.pr-pool-size + " in rotation"; color: Theme.text; font-family: "Rajdhani"; font-weight: 700; font-size: 15px; }
            }
        }
        Rectangle { height: 1px; background: Theme.line-soft; }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width;
                if Outreach.pool-list.length == 0: Text {
                    text: "Press the praying hands on a contact to add them. Answered requests leave the rotation.";
                    wrap: word-wrap;
                    color: Theme.muted;
                    font-family: "Rajdhani";
                    font-weight: 600;
                    font-size: 15px;
                }
                for c in Outreach.pool-list: ContactItem { c: c; }
            }
        }
    }
}

component UpcomingPane inherits Rectangle {
    VerticalLayout {
        HorizontalLayout {
            padding: 10px;
            height: 52px;
            VerticalLayout {
                alignment: center;
                Kicker { text: "NEXT 30 DAYS"; }
                Text { text: Outreach.upcoming.length + " coming up"; color: Theme.text; font-family: "Rajdhani"; font-weight: 700; font-size: 15px; }
            }
        }
        Rectangle { height: 1px; background: Theme.line-soft; }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width;
                if Outreach.upcoming.length == 0: Text {
                    text: "No events in the next 30 days.";
                    color: Theme.muted;
                    font-family: "Rajdhani";
                    font-weight: 600;
                    font-size: 15px;
                }
                for ev in Outreach.upcoming: EventItem { e: ev; }
            }
        }
    }
}

component OutreachView inherits Rectangle {
    HorizontalLayout {
        Rectangle {
            width: 124px;
            background: Theme.chrome;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                alignment: start;
                Kicker { text: "OUTREACH"; }
                TabButton { label: "CONTACTS"; active: Outreach.tab == "contacts"; clicked => { Outreach.tab = "contacts"; } }
                TabButton { label: "UPCOMING"; active: Outreach.tab == "upcoming"; clicked => { Outreach.tab = "upcoming"; } }
                TabButton { label: "PRAYER"; active: Outreach.tab == "prayer"; clicked => { Outreach.tab = "prayer"; } }
                Rectangle { height: 8px; }
                Text {
                    text: Outreach.hint;
                    wrap: word-wrap;
                    color: Theme.amber;
                    font-family: "Share Tech Mono";
                    font-size: 10px;
                    letter-spacing: 0.6px;
                }
            }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
        }
        Rectangle {
            width: max(300px, min(392px, root.width * 0.34));
            background: Theme.bg;
            if Outreach.tab == "contacts": ContactsPane { width: 100%; height: 100%; }
            if Outreach.tab == "upcoming": UpcomingPane { width: 100%; height: 100%; }
            if Outreach.tab == "prayer": PrayerPane { width: 100%; height: 100%; }
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line-soft; }
        }
        CalendarPane { horizontal-stretch: 1; }
    }
}

component PrayerCard inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    height: 190px;
    HorizontalLayout {
        padding: 16px;
        spacing: 16px;
        if Outreach.pr-has: Avatar {
            photo: Outreach.pr-photo;
            has-photo: Outreach.pr-has-photo;
            initials: Outreach.pr-initials;
            size: 96px;
            y: 8px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            Kicker { text: "TODAY'S PRAYER"; }
            if Outreach.pr-has: Text {
                text: Outreach.pr-name;
                color: Theme.cyan;
                font-family: "Rajdhani";
                font-weight: 700;
                font-size: 24px;
                overflow: elide;
            }
            if Outreach.pr-has: Text {
                text: Outreach.pr-request != "" ? Outreach.pr-request : "No prayer request written yet.";
                color: Outreach.pr-request != "" ? Theme.text : Theme.muted;
                wrap: word-wrap;
                font-family: "Rajdhani";
                font-weight: 500;
                font-size: 16px;
                vertical-stretch: 1;
            }
            if !Outreach.pr-has: Text {
                text: "Add someone to pray for";
                color: Theme.text;
                font-family: "Rajdhani";
                font-weight: 700;
                font-size: 22px;
            }
            if !Outreach.pr-has: Text {
                text: "Tap the praying hands on a contact in Outreach and they will appear here, one person a day.";
                color: Theme.muted;
                wrap: word-wrap;
                font-family: "Rajdhani";
                font-weight: 600;
                font-size: 15px;
                vertical-stretch: 1;
            }
            HorizontalLayout {
                alignment: start;
                Rectangle { width: 160px; Btn { label: "OPEN OUTREACH"; active: true; clicked => { Outreach.open(); } } }
            }
        }
    }
}

component HomeView inherits Flickable {
    VerticalLayout {
        width: parent.width;
        padding: 36px;
        spacing: 22px;
        Kicker { text: "FIELD READER"; }
        HorizontalLayout {
            spacing: 10px;
            alignment: center;
            Text {
                text: "TWM BIBLE";
                font-family: "Orbitron";
                font-weight: 700;
                font-size: 28px;
                letter-spacing: 3px;
                color: Theme.cyan;
            }
            Rectangle {
                width: 10px;
                height: 18px;
                background: Theme.cyan;
                opacity: mod(animation-tick() / 1ms, 1200) < 600 ? 1 : 0;
            }
            if Session.intro-available: Rectangle {
                width: 30px;
                height: 30px;
                border-width: 1px;
                border-color: intro-touch.has-hover ? Theme.cyan : Theme.line;
                background: intro-touch.has-hover ? Theme.hover : transparent;
                Path {
                    x: 11px;
                    y: 8px;
                    width: 11px;
                    height: 14px;
                    commands: "M 0 0 L 11 7 L 0 14 Z";
                    fill: Theme.cyan;
                }
                intro-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Session.play-intro(); }
                }
            }
            Rectangle {
                width: 118px;
                height: 30px;
                border-width: 1px;
                border-color: out-touch.has-hover ? Theme.cyan : Theme.line;
                background: out-touch.has-hover ? Theme.hover : transparent;
                Text {
                    text: "OUTREACH";
                    color: Theme.cyan;
                    font-family: "Rajdhani";
                    font-weight: 700;
                    font-size: 14px;
                    letter-spacing: 1.4px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                out-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Outreach.open(); }
                }
            }
        }
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                height: 250px;
                horizontal-stretch: 2;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                HorizontalLayout {
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 16px;
                    spacing: 8px;
                    Kicker { text: "CONTINUE"; }
                    Text {
                        text: Session.continue-ref;
                        font-family: "Rajdhani";
                        font-weight: 700;
                        font-size: 22px;
                        color: Theme.cyan;
                        wrap: word-wrap;
                    }
                    Text {
                        text: Session.continue-snippet;
                        wrap: word-wrap;
                        font-family: "Rajdhani";
                        font-weight: 500;
                        font-size: 16px;
                        color: Theme.text;
                        vertical-stretch: 1;
                    }
                    Btn { label: "OPEN"; active: true; clicked => { Session.continue-reading(); } }
                }
                Rectangle { width: 1px; background: Theme.line-soft; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 16px;
                    spacing: 8px;
                    Kicker { text: "FIND A VERSE"; }
                    Text {
                        text: "Search by book, chapter and verse.";
                        wrap: word-wrap;
                        font-family: "Rajdhani";
                        font-weight: 600;
                        font-size: 16px;
                        color: Theme.muted;
                        vertical-stretch: 1;
                    }
                    Btn { label: "BOOK · CHAPTER · VERSE"; active: true; clicked => { Session.ref-popup = true; } }
                }
                }
            }
            Rectangle {
                height: 250px;
                horizontal-stretch: 1;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Kicker { text: "JUMP"; }
                    Text {
                        text: "A book, or book chapter:verse.";
                        wrap: word-wrap;
                        font-family: "Rajdhani";
                        font-weight: 600;
                        font-size: 16px;
                        color: Theme.muted;
                    }
                    jump-field := Field {
                        placeholder: "John 3:16";
                        accepted(value) => { Session.search-passage(value); }
                    }
                    Btn { label: "GO"; active: true; clicked => { Session.search-passage(jump-field.text); } }
                }
            }
            Rectangle {
                height: 250px;
                horizontal-stretch: 1;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    Kicker { text: "LIBRARY"; }
                    Text {
                        text: Session.version-label;
                        font-family: "Rajdhani";
                        font-weight: 700;
                        font-size: 20px;
                        color: Theme.text;
                    }
                    Kicker { text: "\{Session.version-count} TEXTS ON"; }
                    Kicker { text: "\{Session.note-count} NOTES"; }
                    Kicker { text: "\{Session.mark-count} HIGHLIGHTS"; }
                    Rectangle { vertical-stretch: 1; }
                    Btn { label: "OPTIONS"; clicked => { Session.commit-note(); Session.view = "options"; } }
                }
            }
        }
        HorizontalLayout {
            spacing: 14px;
            PrayerCard { horizontal-stretch: 2; }
            Rectangle { horizontal-stretch: 3; }
        }
    }
}

component BookmarksView inherits Rectangle {
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 22px;
        spacing: 12px;
        Kicker { text: "BOOKMARKS  ·  \{Session.bookmark-count}"; }
        if Session.bookmarks.length == 0: Text {
            text: "No bookmarks yet. Select a verse in Read and press BOOKMARK (Ctrl+B).";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 600;
            font-size: 16px;
            color: Theme.muted;
        }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                for mark[index] in Session.bookmarks: Rectangle {
                    height: max(mark-text.preferred-height, 18px) + 44px;
                    border-width: 1px;
                    border-color: Theme.line-soft;
                    background: Theme.panel;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        Text {
                            text: mark.reference;
                            font-family: "Rajdhani";
                            font-weight: 700;
                            font-size: 15px;
                            color: Theme.cyan;
                        }
                        mark-text := Text {
                            text: mark.snippet;
                            wrap: word-wrap;
                            font-family: "Rajdhani";
                            font-weight: 500;
                            font-size: 15px;
                            color: Theme.text;
                        }
                    }
                    open-touch := TouchArea {
                        width: parent.width - 100px;
                        mouse-cursor: pointer;
                        clicked => { Session.open-bookmark(index); }
                    }
                    Rectangle {
                        x: parent.width - 92px;
                        y: parent.height - 36px;
                        width: 84px;
                        height: 28px;
                        Btn { label: "DELETE"; clicked => { Session.delete-bookmark(index); } }
                    }
                }
            }
        }
    }
}

component BookColumn inherits Rectangle {
    background: Theme.panel;
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 12px;
        spacing: 6px;
        Kicker { text: "BOOKS"; }
        Text {
            text: Session.version-label;
            font-family: "Rajdhani";
            font-weight: 700;
            font-size: 16px;
            color: Theme.cyan;
            overflow: elide;
        }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width;
                for book in Session.books: BookRowView {
                    id: book.id;
                    name: book.name;
                    chapters: book.chapters;
                    current: book.current;
                    section: book.section;
                }
            }
        }
    }
}

component Swatch inherits Rectangle {
    in property <color> ink;
    in property <bool> active: false;
    callback clicked();
    width: 22px;
    height: 22px;
    background: root.ink;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.text : Theme.line;
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component NoteArea inherits Rectangle {
    in-out property <string> text;
    height: 78px;
    background: Theme.input;
    border-width: 1px;
    border-color: Theme.line;
    TextInput {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: parent.height - 12px;
        text <=> root.text;
        single-line: false;
        wrap: word-wrap;
        color: Theme.text;
        font-family: "Rajdhani";
        font-weight: 500;
        font-size: 16px;
        selection-background-color: Theme.light ? #08788833 : #3df0ff33;
        selection-foreground-color: Theme.text;
    }
}

component Inspector inherits Rectangle {
    background: Theme.panel;
    clip: true;
    Flickable {
        width: 100%;
        height: 100%;
        // Never wider than the panel: long words, chips and passages wrap or scroll inside it.
        content-width: self.width;
        VerticalLayout {
            width: parent.width;
            padding: 14px;
            spacing: 8px;
            Kicker { text: "VERSE"; }
            Text {
                text: Session.verse-open ? Session.verse-ref : "No verse selected";
                wrap: word-wrap;
                font-family: "Rajdhani";
                font-weight: 700;
                font-size: 18px;
                color: Theme.cyan;
            }
            if !Session.verse-open: Text {
                text: "Click a verse for a note or a word sense. Click its number to mark it. The mark stays until you remove it.";
                wrap: word-wrap;
                font-family: "Rajdhani";
                font-weight: 600;
                font-size: 15px;
                color: Theme.muted;
            }
            Kicker { text: "HIGHLIGHT"; }
            HorizontalLayout {
                spacing: 6px;
                Swatch { ink: Theme.cyan; active: Session.mark-color == "cyan"; clicked => { Session.set-mark("cyan"); } }
                Swatch { ink: Theme.magenta; active: Session.mark-color == "magenta"; clicked => { Session.set-mark("magenta"); } }
                Swatch { ink: Theme.amber; active: Session.mark-color == "amber"; clicked => { Session.set-mark("amber"); } }
                Swatch { ink: Theme.ok; active: Session.mark-color == "mint"; clicked => { Session.set-mark("mint"); } }
                Swatch { ink: Theme.red; active: Session.mark-color == "red"; clicked => { Session.set-mark("red"); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; Btn { label: "REMOVE"; clicked => { Session.clear-mark(); } } }
                Rectangle { horizontal-stretch: 1; Btn { label: "COPY"; clicked => { Session.copy-verse(); } } }
            }
            Kicker { text: "NOTE"; }
            NoteArea { text <=> Session.note-text; }
            Kicker { text: "LINKS"; }
            Field {
                placeholder: "Romans 8:28, Psalm 23:1";
                text <=> Session.link-text;
            }
            if Session.links.length > 0: Flickable {
                height: 30px;
                HorizontalLayout {
                    spacing: 6px;
                    for link in Session.links: Rectangle {
                        width: link-label.preferred-width + 14px;
                        height: 26px;
                        border-width: 1px;
                        border-color: Theme.line-soft;
                        link-label := Text {
                            text: link.label;
                            font-family: "Rajdhani";
                            font-weight: 700;
                            font-size: 13px;
                            color: Theme.cyan;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Session.open-link(link.book-id, link.chapter, link.verse); }
                        }
                    }
                }
            }
            Btn { label: "SAVE NOTE"; active: true; clicked => { Session.save-note(); } }
            Kicker { text: "WORDS"; }
            WordStrip {}
            lookup-field := Field {
                placeholder: "Type a word";
                accepted(value) => { Session.lookup-typed(value); }
            }
            Btn { label: "LOOK UP"; clicked => { Session.lookup-typed(lookup-field.text); } }
            Kicker { text: Session.sense-word == "" ? "SENSE" : "SENSE  ·  " + Session.sense-word; }
            Text {
                text: Session.sense-text;
                wrap: word-wrap;
                font-family: "Rajdhani";
                font-weight: 500;
                font-size: 15px;
                color: Theme.text;
            }
            Kicker { text: "DICTIONARY"; }
            Text {
                text: Session.modern-text == "" ? "A modern definition is fetched once, then kept on this computer." : Session.modern-text;
                wrap: word-wrap;
                font-family: "Rajdhani";
                font-weight: 500;
                font-size: 15px;
                color: Theme.muted;
            }
            if Session.query-word != "": Kicker { text: "PASSAGES  ·  " + Session.query-word + "  ·  " + Session.search-summary; }
            for hit[index] in Session.word-hits: HitView {
                reference: hit.reference;
                snippet: hit.snippet;
                lines: hit.lines;
                index: index;
            }
            Rectangle { height: 12px; }
        }
    }
}

component ReadView inherits Rectangle {
    private property <length> scroll-watch: Session.scroll-y;
    private property <int> chapter-watch: Session.chapter-token;
    private property <length> chip-watch: Session.chapter-x;
    // The side columns shrink with the window, so a narrow or tiled window keeps the right
    // panel on screen. At 1180px wide this is the usual 236 / 318.
    private property <length> book-w: max(150px, min(236px, root.width * 0.2));
    private property <length> side-w: max(240px, min(318px, root.width * 0.3));
    HorizontalLayout {
        height: parent.height;
        alignment: Session.reading-mode ? center : stretch;
        if !Session.reading-mode: BookColumn { width: root.book-w; }
        if !Session.reading-mode: Rectangle { width: 1px; background: Theme.line; }
        VerticalLayout {
            width: Session.reading-mode ? min(root.width - 24px, 900px) : max(300px, root.width - root.book-w - root.side-w - 2px);
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                alignment: stretch;
                Rectangle { width: 68px; Btn { label: "PREV"; clicked => { if Session.can-prev { Session.step(-1); } } } }
                Rectangle {
                    horizontal-stretch: 1;
                    background: title-touch.has-hover ? Theme.hover : transparent;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: Session.place-title;
                        font-family: "Orbitron";
                        font-weight: 700;
                        font-size: 16px;
                        letter-spacing: 1px;
                        color: Theme.cyan;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    title-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Session.ref-popup = true; }
                    }
                }
                if Session.reading-mode: Rectangle { width: 60px; Btn { label: "EXIT"; clicked => { Session.reading-mode = false; } } }
                Rectangle { width: 92px; Btn { label: "CHAPTER"; clicked => { Session.chapter-popup = true; } } }
                Rectangle { width: 68px; Btn { label: "NEXT"; clicked => { if Session.can-next { Session.step(1); } } } }
            }
            if !Session.reading-mode: HorizontalLayout {
                spacing: 8px;
                alignment: stretch;
                go-field := Field {
                    min-width: 180px;
                    horizontal-stretch: 1;
                    placeholder: "John 3:16";
                    accepted(value) => { Session.search-passage(value); }
                }
                Rectangle { width: 64px; Btn { label: "GO"; active: true; clicked => { Session.search-passage(go-field.text); } } }
            }
            if !Session.reading-mode: HorizontalLayout {
                spacing: 6px;
                Btn { label: "BACK"; clicked => { if Session.can-back { Session.go-back(); } } }
                Btn { label: Session.compare-on ? "SPLIT · " + Session.compare-label : "SPLIT"; active: Session.compare-on; clicked => { Session.set-compare(!Session.compare-on); } }
                Btn { label: "EXPORT"; clicked => { Session.export-popup = true; } }
                Btn { label: "BOOKMARK"; active: Session.is-bookmarked; clicked => { Session.toggle-bookmark(); } }
            }
            chap-flick := Flickable {
                height: Session.reading-mode ? 0px : 32px;
                visible: !Session.reading-mode;
                HorizontalLayout {
                    spacing: 4px;
                    for chapter in Session.chapters: ChapterChip {
                        num: chapter.num;
                        current: chapter.current;
                    }
                }
            }
            live-flick := Flickable {
                height: Session.reading-mode ? 0px : 32px;
                visible: !Session.reading-mode;
                HorizontalLayout {
                    spacing: 6px;
                    for edition in Session.live-versions: Rectangle {
                        width: max(edition-label.preferred-width + 16px, 72px);
                        height: 28px;
                        border-width: 1px;
                        border-color: edition.active ? Theme.cyan : Theme.line-soft;
                        background: edition.active ? Theme.hover : transparent;
                        edition-label := Text {
                            text: edition.label;
                            font-family: "Rajdhani";
                            font-weight: 700;
                            font-size: 13px;
                            letter-spacing: 1px;
                            color: edition.active ? Theme.cyan : Theme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Session.set-version(edition.id); }
                        }
                    }
                }
            }
            verse-flick := Flickable {
                vertical-stretch: 1;
                init => { Session.text-width((self.width - 84px) / 1px); }
                changed width => { Session.text-width((self.width - 84px) / 1px); }
                VerticalLayout {
                    width: parent.width;
                    spacing: 1px;
                    for verse in Session.verses: VerseLine {
                        number: verse.number;
                        body: verse.text;
                        mark: verse.mark;
                        has-note: verse.has-note;
                        selected: verse.selected;
                        bookmarked: verse.bookmarked;
                        body2: verse.text2;
                        lines2: verse.lines2;
                        side: verse.side;
                        lines: verse.lines;
                    }
                }
            }
        }
        if !Session.reading-mode: Rectangle { width: 1px; background: Theme.line; }
        if !Session.reading-mode: Inspector { width: root.side-w; }
    }
    changed scroll-watch => {
        if Session.focus-verse > 0 {
            verse-flick.content-y = -root.scroll-watch + 8px;
        }
    }
    changed chapter-watch => {
        if Session.focus-verse == 0 {
            verse-flick.content-y = 0;
        }
    }
    changed chip-watch => {
        chap-flick.content-x = -root.chip-watch + 8px;
    }
}

component SearchView inherits Rectangle {
    property <string> mode: "passage";
    changed width => { Session.hit-width((self.width - 44px - 16px) / 1px); }
    init => { Session.hit-width((self.width - 44px - 16px) / 1px); }
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding: 22px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 140px; Btn { label: "PASSAGE"; active: root.mode == "passage"; clicked => { root.mode = "passage"; } } }
            Rectangle { width: 140px; Btn { label: "WORDS"; active: root.mode == "words"; clicked => { root.mode = "words"; } } }
        }
        query-field := Field {
            placeholder: root.mode == "words" ? "only begotten" : "John 3:16";
            accepted(value) => {
                if root.mode == "words" { Session.search-words(value); }
                else { Session.search-passage(value); }
            }
        }
        if root.mode == "words": VerticalLayout {
            spacing: 8px;
            Kicker { text: "Quote a phrase for an exact match. Several words match verses that hold all of them."; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                Btn { label: "ALL"; active: Session.search-scope == "all"; clicked => { Session.search-scope = "all"; } }
                Btn { label: "OLD TESTAMENT"; active: Session.search-scope == "ot"; clicked => { Session.search-scope = "ot"; } }
                Btn { label: "NEW TESTAMENT"; active: Session.search-scope == "nt"; clicked => { Session.search-scope = "nt"; } }
            }
            Field {
                placeholder: "Limit to one book (optional), such as John";
                text <=> Session.search-book;
            }
        }
        Btn {
            label: root.mode == "words" ? "SEARCH" : "OPEN";
            active: true;
            clicked => {
                if root.mode == "words" { Session.search-words(query-field.text); }
                else { Session.search-passage(query-field.text); }
            }
        }
        Kicker { text: Session.search-summary; }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width;
                spacing: 8px;
                for hit[index] in Session.hits: HitView {
                    reference: hit.reference;
                    snippet: hit.snippet;
                    lines: hit.lines;
                    index: index;
                }
            }
        }
    }
}

component OptionsView inherits Flickable {
    VerticalLayout {
        width: parent.width;
        padding: 28px;
        spacing: 16px;
        Kicker { text: "APPEARANCE"; }
        Text {
            text: "Dark and light use the field-journal palette. System follows the desktop and keeps that palette.";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 600;
            font-size: 16px;
            color: Theme.text;
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 120px; Btn { label: "DARK"; active: Session.theme-mode == "dark"; clicked => { Session.set-theme("dark"); } } }
            Rectangle { width: 120px; Btn { label: "LIGHT"; active: Session.theme-mode == "light"; clicked => { Session.set-theme("light"); } } }
            Rectangle { width: 140px; Btn { label: "SYSTEM"; active: Session.theme-mode == "system"; clicked => { Session.set-theme("system"); } } }
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 110px; Btn { label: "SEPIA"; active: Session.theme-mode == "sepia"; clicked => { Session.set-theme("sepia"); } } }
            Rectangle { width: 110px; Btn { label: "AMBER"; active: Session.theme-mode == "amber"; clicked => { Session.set-theme("amber"); } } }
            Rectangle { width: 110px; Btn { label: "FOREST"; active: Session.theme-mode == "forest"; clicked => { Session.set-theme("forest"); } } }
            Rectangle { width: 130px; Btn { label: "HIGH CONTRAST"; active: Session.theme-mode == "contrast"; clicked => { Session.set-theme("contrast"); } } }
        }
        Kicker { text: Session.resolved-theme; }
        Kicker { text: Session.desktop-appearance; }
        Kicker { text: "INTRO VIDEO"; }
        Rectangle {
            width: 320px;
            Btn {
                label: Session.intro-on-start ? "PLAY INTRO VIDEO ON STARTUP: ON" : "PLAY INTRO VIDEO ON STARTUP: OFF";
                active: Session.intro-on-start;
                clicked => { Session.set-intro-on-start(!Session.intro-on-start); }
            }
        }
        Kicker { text: "SIDE-BY-SIDE"; }
        Text {
            text: "Use the 2ND button on a text below, or the SPLIT button in Read, to show it beside the main text. It sits beneath the main text when the window is narrow.";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 600;
            font-size: 16px;
            color: Theme.text;
        }
        Kicker { text: "TEXT SIZE"; }
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Rectangle { width: 48px; Btn { label: "−"; clicked => { Session.bump-size(-1); } } }
            Text {
                text: "\{Session.reading-size}";
                width: 48px;
                font-family: "Share Tech Mono";
                font-size: 16px;
                color: Theme.cyan;
                horizontal-alignment: center;
            }
            Rectangle { width: 48px; Btn { label: "+"; clicked => { Session.bump-size(1); } } }
        }
        Kicker { text: "VERSE SPACING"; }
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            Rectangle { width: 48px; Btn { label: "−"; clicked => { Session.bump-gap(-2); } } }
            Text {
                text: "\{Session.verse-gap}";
                width: 48px;
                font-family: "Share Tech Mono";
                font-size: 16px;
                color: Theme.cyan;
                horizontal-alignment: center;
            }
            Rectangle { width: 48px; Btn { label: "+"; clicked => { Session.bump-gap(2); } } }
        }
        Kicker { text: "READING MODE"; }
        Text {
            text: "Distraction-free full screen: only the chapter and PREV, CHAPTER, NEXT. Press Esc or F11 to leave.";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 600;
            font-size: 16px;
            color: Theme.text;
        }
        Rectangle { width: 220px; Btn { label: "ENTER READING MODE"; active: true; clicked => { Session.view = "read"; Session.reading-mode = true; } } }
        Kicker { text: "LIBRARY"; }
        Text {
            text: "KJV stays on. The other public-domain texts are already on this computer. An import has to be a JSON list of books you have the right to use.";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 600;
            font-size: 16px;
            color: Theme.text;
        }
        for edition in Session.versions: VersionLine {
            id: edition.id;
            label: edition.label;
            enabled: edition.enabled;
            active: edition.active;
            builtin: edition.builtin;
            compare: edition.compare;
        }
        Rectangle { width: 180px; Btn { label: "IMPORT JSON"; active: true; clicked => { Session.import-bible(); } } }
        Kicker { text: "KEYBOARD SHORTCUTS"; }
        Text {
            text: "Ctrl+F  Search\nCtrl+G  Book, chapter and verse\nCtrl+B  Bookmark the selected verse\nLeft / Right, PgUp / PgDn  Previous or next chapter (Read view, no text box focused)\nAlt+Left  Back\nF11  Reading mode on or off\nEsc  Close a popup, or leave reading mode\nHold a word for 0.5 s  Word popup\nOn macOS, Cmd works in place of Ctrl.";
            wrap: word-wrap;
            font-family: "Share Tech Mono";
            font-size: 13px;
            color: Theme.text;
        }
        Kicker { text: "BACKUP"; }
        Text {
            text: "Save your notes, highlights and bookmarks to one JSON file, or restore them from one. Restoring asks whether to merge or replace.";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 600;
            font-size: 16px;
            color: Theme.text;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Rectangle { width: 180px; Btn { label: "EXPORT BACKUP"; active: true; clicked => { Session.export-backup(); } } }
            Rectangle { width: 180px; Btn { label: "RESTORE BACKUP"; clicked => { Session.import-backup(); } } }
        }
        Text {
            text: "Privacy: the backup file now also holds your Outreach contacts (names, phone numbers, emails, prayer requests, photos) and events. Keep it somewhere private; it is not encrypted.";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 700;
            font-size: 15px;
            color: Theme.amber;
        }
        Kicker { text: "ABOUT"; }
        Text {
            text: "TWM Bible 1.1.1. Bundled texts are public domain: KJV 1611 in standard spelling, ASV, WEB, Young’s Literal, Darby, Revised Version, Geneva 1599, and Douay-Rheims. The app code is MIT.";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 600;
            font-size: 16px;
            color: Theme.muted;
        }
        Rectangle { height: 24px; }
    }
}

export component AppWindow inherits Window {
    title: "TWM Bible — " + Session.place-title;
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 720px;
    min-height: 560px;
    background: Theme.bg;
    full-screen: Session.reading-mode;
    // Under 900px (a tiled window) the logo, clock and theme buttons give way to the tabs.
    // Set from `changed width` (not a binding) so the window width and the nav layout cannot form a binding loop.
    private property <bool> narrow: false;
    changed width => { self.narrow = self.width < 900px; }
    init => { self.narrow = self.width < 900px; }
    private property <bool> any-popup: Session.popup-open || Session.ref-popup || Session.chapter-popup || Session.export-popup || Session.import-popup || Outreach.card-open || Outreach.event-open || Outreach.confirm-open;
    private property <int> focus-watch: Session.focus-request;
    private property <string> view-watch: Session.view;
    changed any-popup => { root-fs.focus(); }
    changed focus-watch => { root-fs.focus(); }
    changed view-watch => { root-fs.focus(); }

    root-fs := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if Outreach.confirm-open { Outreach.confirm-open = false; }
                else if Outreach.event-open { Outreach.event-open = false; }
                else if Outreach.card-open { Outreach.card-open = false; }
                else if Session.popup-open { Session.popup-open = false; }
                else if Session.ref-popup { Session.ref-popup = false; }
                else if Session.chapter-popup { Session.chapter-popup = false; }
                else if Session.export-popup { Session.export-popup = false; }
                else if Session.import-popup { Session.import-cancel(); }
                else if Session.reading-mode { Session.reading-mode = false; }
                self.focus();
                return accept;
            }
            if event.text == Key.F11 {
                Session.view = "read";
                Session.reading-mode = !Session.reading-mode;
                return accept;
            }
            if event.modifiers.control || event.modifiers.meta {
                if event.text == "f" || event.text == "\u{6}" { Session.commit-note(); Session.view = "search"; return accept; }
                if event.text == "g" || event.text == "\u{7}" { Session.ref-popup = true; return accept; }
                if event.text == "b" || event.text == "\u{2}" { Session.toggle-bookmark(); return accept; }
            }
            reject
        }
        key-pressed(event) => {
            if Session.view == "read" && !root.any-popup {
                if event.modifiers.alt && event.text == Key.LeftArrow { if Session.can-back { Session.go-back(); } return accept; }
                if event.text == Key.LeftArrow || event.text == Key.PageUp { if Session.can-prev { Session.step(-1); } return accept; }
                if event.text == Key.RightArrow || event.text == Key.PageDown { if Session.can-next { Session.step(1); } return accept; }
            }
            reject
        }


    Rectangle {
        y: 0;
        width: 100%;
        height: 260px;
        visible: !Theme.light && Theme.palette == "default";
        background: @linear-gradient(180deg, #3df0ff16, #00000000);
    }
    Rectangle {
        y: 0;
        width: 100%;
        height: 260px;
        visible: Theme.light && Theme.palette == "default";
        background: @linear-gradient(180deg, #08788818, #00000000);
    }

    if Outreach.card-open: PopupFrame {
        box-width: 520px;
        dismiss => { Outreach.card-open = false; }
        Kicker { text: Outreach.c-id < 0 ? "NEW CONTACT" : "CONTACT CARD"; }
        HorizontalLayout {
            spacing: 14px;
            Avatar { photo: Outreach.c-photo; has-photo: Outreach.c-has-photo; initials: Outreach.c-initials; size: 84px; }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                alignment: center;
                Field { placeholder: "Name"; text <=> Outreach.c-name; init => { self.focus-input(); } }
                HorizontalLayout {
                    spacing: 6px;
                    Btn { label: "CHOOSE PHOTO"; clicked => { Outreach.pick-photo(); } }
                    if Outreach.c-has-photo: Btn { label: "REMOVE PHOTO"; clicked => { Outreach.clear-photo(); } }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Field { placeholder: "Phone"; text <=> Outreach.c-phone; }
            Field { placeholder: "Email (optional)"; text <=> Outreach.c-email; }
        }
        Kicker { text: "PRAYER REQUEST"; }
        NoteArea { text <=> Outreach.c-prayer; }
        HorizontalLayout {
            spacing: 8px;
            Btn { label: Outreach.c-fulfilled ? "PRAYER REQUEST FULFILLED: YES" : "PRAYER REQUEST FULFILLED: NO"; active: Outreach.c-fulfilled; clicked => { Outreach.c-fulfilled = !Outreach.c-fulfilled; } }
            Btn { label: Outreach.c-pool ? "DAILY PRAYER: ON" : "DAILY PRAYER: OFF"; active: Outreach.c-pool; clicked => { Outreach.c-pool = !Outreach.c-pool; } }
        }
        if Outreach.c-error != "": Text { text: Outreach.c-error; color: Theme.red; font-family: "Rajdhani"; font-weight: 700; font-size: 14px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            Btn { label: "SAVE"; active: true; clicked => { Outreach.save-contact(); } }
            if Outreach.c-id >= 0: DangerBtn { label: "DELETE"; clicked => { Outreach.ask-delete-contact(); } }
            Btn { label: "CANCEL"; clicked => { Outreach.card-open = false; } }
        }
    }
    if Outreach.event-open: PopupFrame {
        box-width: 540px;
        dismiss => { Outreach.event-open = false; }
        Kicker { text: Outreach.e-id < 0 ? "NEW EVENT" : "EDIT EVENT"; }
        Field { placeholder: "Title"; text <=> Outreach.e-title; init => { self.focus-input(); } }
        HorizontalLayout {
            spacing: 6px;
            Rectangle { width: 34px; Btn { label: "◀"; clicked => { Outreach.step-date(-1); } } }
            Field { placeholder: "Date  YYYY-MM-DD"; text <=> Outreach.e-date; horizontal-stretch: 1; }
            Rectangle { width: 34px; Btn { label: "▶"; clicked => { Outreach.step-date(1); } } }
            Rectangle { width: 10px; }
            Rectangle { width: 34px; Btn { label: "−"; clicked => { Outreach.step-time(-30); } } }
            Field { placeholder: "Time  19:30"; text <=> Outreach.e-time; width: 110px; }
            Rectangle { width: 34px; Btn { label: "+"; clicked => { Outreach.step-time(30); } } }
        }
        Kicker { text: "REPEAT"; }
        HorizontalLayout {
            spacing: 6px;
            Btn { label: "NONE"; active: Outreach.e-repeat == "none"; clicked => { Outreach.set-repeat("none"); } }
            Btn { label: "WEEKLY"; active: Outreach.e-repeat == "weekly"; clicked => { Outreach.set-repeat("weekly"); } }
            Btn { label: "TWICE A WEEK"; active: Outreach.e-repeat == "twice"; clicked => { Outreach.set-repeat("twice"); } }
            Btn { label: "EVERY OTHER WEEK"; active: Outreach.e-repeat == "biweekly"; clicked => { Outreach.set-repeat("biweekly"); } }
        }
        if Outreach.e-repeat == "twice": HorizontalLayout {
            spacing: 4px;
            for name[i] in ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"]: Btn {
                label: name;
                active: Outreach.e-days[i];
                clicked => { Outreach.toggle-day(i); }
            }
        }
        if Outreach.e-note != "": Text { text: Outreach.e-note; color: Theme.muted; font-family: "Rajdhani"; font-weight: 600; font-size: 14px; wrap: word-wrap; }
        Kicker { text: "DETAILS"; }
        NoteArea { text <=> Outreach.e-details; }
        if Outreach.e-error != "": Text { text: Outreach.e-error; color: Theme.red; font-family: "Rajdhani"; font-weight: 700; font-size: 14px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            Btn { label: "SAVE"; active: true; clicked => { Outreach.save-event(); } }
            if Outreach.e-id >= 0: DangerBtn { label: "DELETE"; clicked => { Outreach.ask-delete-event(); } }
            Btn { label: "CANCEL"; clicked => { Outreach.event-open = false; } }
        }
    }
    if Outreach.confirm-open: PopupFrame {
        box-width: 420px;
        z: 20;
        dismiss => { Outreach.confirm-open = false; }
        Kicker { text: "CONFIRM DELETE"; }
        Text { text: Outreach.confirm-text; wrap: word-wrap; color: Theme.text; font-family: "Rajdhani"; font-weight: 600; font-size: 16px; }
        HorizontalLayout {
            spacing: 8px;
            DangerBtn { label: "YES, DELETE"; clicked => { Outreach.confirm-yes(); } }
            Btn { label: "KEEP IT"; active: true; clicked => { Outreach.confirm-open = false; } }
        }
    }
    if Session.export-popup: PopupFrame {
        dismiss => { Session.export-popup = false; }
        Kicker { text: "EXPORT  ·  " + Session.place-title; }
        Text {
            text: "Leave both boxes empty for the whole chapter, or give a verse range. Open the web page and print it for a PDF, or save a PDF directly.";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 600;
            font-size: 15px;
            color: Theme.muted;
        }
        HorizontalLayout {
            spacing: 8px;
            Field { placeholder: "From verse"; text <=> Session.export-from; }
            Field { placeholder: "To verse"; text <=> Session.export-to; }
        }
        Btn { label: Session.export-notes ? "INCLUDE MY NOTES: YES" : "INCLUDE MY NOTES: NO"; active: Session.export-notes; clicked => { Session.export-notes = !Session.export-notes; } }
        HorizontalLayout {
            spacing: 8px;
            Btn { label: "PDF"; active: true; clicked => { Session.export-passage("pdf"); } }
            Btn { label: "WEB PAGE"; clicked => { Session.export-passage("html"); } }
            Btn { label: "TEXT"; clicked => { Session.export-passage("text"); } }
            Btn { label: "CLOSE"; clicked => { Session.export-popup = false; } }
        }
    }
    if Session.import-popup: PopupFrame {
        dismiss => { Session.import-cancel(); }
        Kicker { text: "RESTORE BACKUP"; }
        Text {
            text: "This file holds " + Session.import-text;
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 600;
            font-size: 16px;
            color: Theme.text;
        }
        Text {
            text: "MERGE keeps what you have and adds what is missing. REPLACE swaps your notes, highlights, bookmarks and Outreach contacts and events for the file's. A copy of your current settings is saved first.";
            wrap: word-wrap;
            font-family: "Rajdhani";
            font-weight: 500;
            font-size: 15px;
            color: Theme.muted;
        }
        HorizontalLayout {
            spacing: 8px;
            Btn { label: "MERGE"; active: true; clicked => { Session.import-apply(false); } }
            Btn { label: "REPLACE"; clicked => { Session.import-apply(true); } }
            Btn { label: "CANCEL"; clicked => { Session.import-cancel(); } }
        }
    }
    if Session.ref-popup: PopupFrame {
        dismiss => { Session.ref-popup = false; }
        Kicker { text: "OPEN A PASSAGE"; }
        ref-field := Field {
            placeholder: "John 3:16";
            init => { self.focus-input(); }
            accepted(value) => { Session.search-passage(value); Session.ref-popup = false; }
        }
        Kicker { text: "OR PICK A BOOK"; }
        Flickable {
            height: 200px;
            GridLayout {
                spacing: 4px;
                for book[i] in Session.books: Rectangle {
                    row: floor(i / 3);
                    col: mod(i, 3);
                    height: 28px;
                    border-width: 1px;
                    border-color: book.current ? Theme.cyan : Theme.line-soft;
                    background: book-touch.has-hover ? Theme.hover : transparent;
                    Text {
                        text: book.name;
                        font-family: "Rajdhani";
                        font-weight: 600;
                        font-size: 14px;
                        color: book.current ? Theme.cyan : Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    book-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Session.select-book(book.id); Session.ref-popup = false; }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Btn { label: "GO"; active: true; clicked => { Session.search-passage(ref-field.text); Session.ref-popup = false; } }
            Btn { label: "CLOSE"; clicked => { Session.ref-popup = false; } }
        }
    }
    if Session.chapter-popup: PopupFrame {
        box-width: 420px;
        dismiss => { Session.chapter-popup = false; }
        Kicker { text: "CHAPTER  ·  " + Session.place-title; }
        Flickable {
            height: 220px;
            GridLayout {
                spacing: 4px;
                for chapter[i] in Session.chapters: Rectangle {
                    row: floor(i / 8);
                    col: mod(i, 8);
                    height: 32px;
                    border-width: 1px;
                    border-color: chapter.current ? Theme.cyan : Theme.line-soft;
                    background: chap-touch.has-hover || chapter.current ? Theme.hover : transparent;
                    Text {
                        text: "\{chapter.num}";
                        color: chapter.current ? Theme.cyan : Theme.text;
                        font-family: "Share Tech Mono";
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    chap-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Session.select-chapter(chapter.num); Session.chapter-popup = false; }
                    }
                }
            }
        }
        Btn { label: "CLOSE"; clicked => { Session.chapter-popup = false; } }
    }
    if Session.popup-open: Rectangle {
        z: 10;
        background: #00000088;
        TouchArea { clicked => { Session.popup-open = false; } }
        Rectangle {
            private property <length> pw: min(460px, parent.width - 40px);
            private property <length> ph: min(parent.height - 40px, pop-col.preferred-height + 32px);
            // Below the pressed line when it fits, above it when it does not, and always inside the window.
            private property <length> below: Session.popup-bottom + 6px;
            private property <length> above: Session.popup-bottom - Session.popup-line - 6px - self.ph;
            width: self.pw;
            height: self.ph;
            x: Session.popup-anchored ? max(20px, min(parent.width - self.pw - 20px, Session.popup-x - self.pw / 2)) : (parent.width - self.pw) / 2;
            y: !Session.popup-anchored ? (parent.height - self.ph) / 2
                : self.below + self.ph <= parent.height - 8px ? self.below
                : self.above >= 8px ? self.above
                : max(8px, parent.height - self.ph - 8px);
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.cyan;
            TouchArea {}
            pop-col := VerticalLayout {
                padding: 16px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    min-height: 80px;
                    Kicker { text: "WORD  ·  " + Session.sense-word; horizontal-stretch: 1; vertical-stretch: 0; }
                    if Session.lookup-busy: GrokBotSprite { busy: true; }
                }
                Kicker { text: "ARCHAIC"; }
                Text {
                    text: Session.sense-text;
                    wrap: word-wrap;
                    font-family: "Rajdhani";
                    font-weight: 500;
                    font-size: 16px;
                    color: Theme.text;
                }
                Kicker { text: "MODERN"; }
                Text {
                    text: Session.modern-text == "" ? "No modern definition yet." : Session.modern-text;
                    wrap: word-wrap;
                    font-family: "Rajdhani";
                    font-weight: 500;
                    font-size: 16px;
                    color: Theme.muted;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Btn { label: "COPY VERSE"; clicked => { Session.copy-verse(); } }
                    Btn { label: "SEARCH THIS WORD"; active: true; clicked => { Session.search-this-word(); } }
                    Btn { label: "CLOSE"; clicked => { Session.popup-open = false; } }
                }
            }
        }
    }

    VerticalLayout {
        if !Session.reading-mode: Rectangle {
            height: 74px;
            background: Theme.chrome;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 8px;
                alignment: stretch;
                if !root.narrow: Image {
                    source: @image-url("../assets/icon-256.png");
                    width: 36px;
                    height: 36px;
                }
                if !root.narrow: VerticalLayout {
                    spacing: 0;
                    alignment: center;
                    Kicker { text: "FIELD READER"; }
                    Text {
                        text: "TWM BIBLE";
                        font-family: "Orbitron";
                        font-weight: 700;
                        font-size: 16px;
                        letter-spacing: 2px;
                        color: Theme.cyan;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle { width: 76px; Btn { label: "HOME"; active: Session.view == "home"; clicked => { Session.commit-note(); Session.view = "home"; } } }
                Rectangle { width: 76px; Btn { label: "READ"; active: Session.view == "read"; clicked => { Session.commit-note(); Session.view = "read"; } } }
                Rectangle { width: 108px; Btn { label: "BOOKMARKS"; active: Session.view == "bookmarks"; clicked => { Session.commit-note(); Session.view = "bookmarks"; } } }
                Rectangle { width: 90px; Btn { label: "SEARCH"; active: Session.view == "search"; clicked => { Session.commit-note(); Session.view = "search"; } } }
                Rectangle { width: 98px; Btn { label: "OUTREACH"; active: Session.view == "outreach"; clicked => { Session.commit-note(); Outreach.open(); } } }
                Rectangle { width: 94px; Btn { label: "OPTIONS"; active: Session.view == "options"; clicked => { Session.commit-note(); Session.view = "options"; } } }
                if !root.narrow: Rectangle {
                    width: 1px;
                    height: 28px;
                    background: Theme.line;
                }
                if !root.narrow: Rectangle {
                    width: 180px;
                    Text {
                        x: 0px;
                        y: 2px;
                        width: 180px;
                        height: 16px;
                        text: Session.clock;
                        font-family: "Share Tech Mono";
                        font-size: 11px;
                        letter-spacing: 0.8px;
                        color: Theme.muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        x: 0px;
                        y: 24px;
                        width: 180px;
                        height: 32px;
                        spacing: 4px;
                        Rectangle { horizontal-stretch: 1; Btn { label: "DARK"; active: Session.theme-mode == "dark"; clicked => { Session.set-theme("dark"); } } }
                        Rectangle { horizontal-stretch: 1; Btn { label: "LIGHT"; active: Session.theme-mode == "light"; clicked => { Session.set-theme("light"); } } }
                        Rectangle { horizontal-stretch: 1; Btn { label: "SYSTEM"; active: Session.theme-mode == "system"; clicked => { Session.set-theme("system"); } } }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.line; }
        }
        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            if Session.view == "home": HomeView { width: 100%; height: 100%; }
            if Session.view == "read": ReadView { width: 100%; height: 100%; }
            if Session.view == "search": SearchView { width: 100%; height: 100%; }
            if Session.view == "bookmarks": BookmarksView { width: 100%; height: 100%; }
            if Session.view == "options": OptionsView { width: 100%; height: 100%; }
            if Session.view == "outreach": OutreachView { width: 100%; height: 100%; }
        }
        if !Session.reading-mode: Rectangle {
            height: 28px;
            background: Theme.chrome;
            Rectangle { height: 1px; width: 100%; background: Theme.line; }
            Text {
                x: 14px;
                y: 1px;
                width: parent.width - 28px;
                height: parent.height - 1px;
                text: Session.status;
                font-family: "Share Tech Mono";
                font-size: 11px;
                letter-spacing: 1px;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    }
}
